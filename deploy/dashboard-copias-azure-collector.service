[Unit]
Description=Dashboard de Copias Azure (recogida de datos)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=dashboard-copias
Group=dashboard-copias
WorkingDirectory=/opt/dashboard-copias-azure
# El guion inicial hace que un fallo del primer colector no impida el segundo:
# cada uno escribe su propio JSON y reporta sus errores en el dashboard.
ExecStart=-/opt/dashboard-copias-azure/venv/bin/python /opt/dashboard-copias-azure/collect.py --out /opt/dashboard-copias-azure/public
ExecStart=/opt/dashboard-copias-azure/venv/bin/python /opt/dashboard-copias-azure/collect_runbooks.py --out /opt/dashboard-copias-azure/public
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dashboard-copias-azure-collector

# collect.py devuelve 2 cuando hay copias en fallo: es un resultado, no un error
SuccessExitStatus=0 2

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/opt/dashboard-copias-azure

[Install]
WantedBy=multi-user.target
