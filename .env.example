# Credenciales del Service Principal (App Registration en Entra ID)
# Copia este fichero a .env y rellena los valores.  chmod 600 .env
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Vaults a monitorizar, separados por comas. Vacio = todos los visibles.
AZURE_VAULTS=STNCERAMICA-backup

# Dias de historico de jobs
BACKUP_DAYS=7

# Horas sin backup correcto antes de marcar "Atencion"
BACKUP_SLA_HOURS=26

# Salida y servidor web
OUTPUT_DIR=/opt/dashboard-copias-azure/public
SERVE_PORT=8090
SERVE_BIND=0.0.0.0
